PROJECT_NAME           = muypoco
PROJECT_BRIEF          = "Header-only C++20 bits"
PREDEFINED             = NDEBUG
OUTPUT_DIRECTORY       = docs/build
INPUT                  = README.md docs/events.md docs/chan.md docs/timers.md docs/log.md events.h chan.h timers.h log.h detail/events/fixed_string.h detail/events/validation.h
USE_MDFILE_AS_MAINPAGE = README.md
EXCLUDE_SYMBOLS        = muypoco::detail muypoco::detail::*
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
SHOW_FILES             = NO
SHOW_NAMESPACES        = NO
FULL_PATH_NAMES        = NO
QUIET                  = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
HTML_EXTRA_STYLESHEET  = docs/theme/doxygen-awesome.css docs/theme/doxygen-awesome-sidebar-only.css
